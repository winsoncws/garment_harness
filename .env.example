# =====================================================================
# Copy to `.env` and edit. Nothing here is secret except the API key.
#
#   cp .env.example .env
#   set -a; source .env; set +a        # load into your shell (bash/zsh)
#
# Every one of these has a working default -- you only need the ones
# that differ on your machine.
# =====================================================================

# --- where Ollama lives ----------------------------------------------
# On the GPU server itself, the default is already right.
# From your Mac, point at the GPU box AND start ollama with
#   OLLAMA_HOST=0.0.0.0 ollama serve
# on that box, or it only listens on localhost.
GMT_OLLAMA_HOST=http://localhost:11434

# --- the database ----------------------------------------------------
# Absolute path recommended on the server. One file, holds everything.
# GMT_DB=/data/garment/garment.db

# --- cost / data-residency ceiling -----------------------------------
# 2 = never leave the building. Tier 3 (cloud) becomes unreachable and
# tasks that would have escalated there just fail loudly instead.
# GMT_MAX_TIER=2

# --- run with the fake model: no GPU, no network, instant ------------
# GMT_OFFLINE=1

# --- logging ---------------------------------------------------------
# GMT_LOG_LEVEL=DEBUG

# --- tier 3 (optional; leave unset to disable the cloud entirely) ----
# ANTHROPIC_API_KEY=sk-ant-...

# --- the trained defect CNN (optional; TorchScript .pt) --------------
# GMT_CNN_MODEL=/models/defect_v1.pt
